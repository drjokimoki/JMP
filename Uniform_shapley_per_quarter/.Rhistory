hist(vals, breaks = br, add = TRUE,
col = hist_cols[j], border = NA)
}
abline(v = c(0.10, 0.20), col = "grey30", lty = 2, lwd = 1.2)
text(c(0.10, 0.20), par("usr")[4] * 0.97,
labels = c("\u03c4=0.10", "\u03c4=0.20"),
pos = 4, cex = 0.78, col = "grey30")
legend("topright",
legend = paste0("PC", seq_len(n_pc)),
fill   = hist_cols[seq_len(n_pc)],
bty = "n", cex = 0.85)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot S4: Stage 2 Factor Stability  (log y-axis)
# -----------------------------------------------------------------------------
plot_s2_stability <- function(results, save_path = NULL) {
opened <- .open_device(save_path, width = 600, height = 560)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
cfg    <- results$config
r_true <- cfg$r_true
V      <- results$stage2$stability$V[seq_len(r_true)]
fnames <- c("F1  (Strong)", "F2  (Weak)")[seq_len(r_true)]
fcols  <- c("green3", "orange")[seq_len(r_true)]
log_V   <- log10(V)
y_range <- c(floor(min(log_V)) - 0.4, ceiling(max(log_V)) + 0.6)
bp <- barplot(log_V,
names.arg = fnames,
col    = adjustcolor(fcols, 0.75),
border = "grey30",
ylim   = y_range,
axes   = FALSE,
ylab   = "Stability V  (lower = more stable)",
main   = "Stage 2: Factor Stability")
pow_seq <- seq(floor(y_range[1]), ceiling(y_range[2]))
axis(2, at = pow_seq,
labels = parse(text = paste0("10^", pow_seq)),
las = 1)
box()
text(bp, log_V + 0.08,
labels = formatC(V, format = "e", digits = 3),
cex = 0.90, xpd = TRUE)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot S5: R² vs True Factors
# -----------------------------------------------------------------------------
plot_s2_r_squared <- function(results, save_path = NULL) {
opened <- .open_device(save_path)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
cfg      <- results$config
r_true   <- cfg$r_true
r_sq     <- results$stage2$r_squared
methods  <- c("full_sample", "mean_agg", "median_agg", "weighted_agg")
mlabels  <- c("Full Sample", "Mean", "Median", "Weighted")
n_m      <- length(methods)
x_pos    <- seq_len(r_true) - 1
w        <- 0.20
plot.new()
plot.window(xlim = c(-0.5, r_true - 0.5), ylim = c(0, 1.15))
axis(1, at = x_pos, labels = paste0("F", seq_len(r_true)))
axis(2); box()
title(xlab = "", ylab = expression(R^2),
main = expression(R^2 ~ "vs True Factors  (by estimation method)"))
abline(h = 1.0, col = "grey80", lty = 2)
for (i in seq_along(methods)) {
m <- methods[i]
if (!is.null(r_sq[[m]])) {
vals   <- r_sq[[m]][seq_len(r_true)]
offset <- (i - (n_m + 1) / 2) * w
rect(x_pos + offset - w / 2, 0,
x_pos + offset + w / 2, vals,
col    = adjustcolor(.TAB10[i], 0.78),
border = "white", lwd = 0.5)
}
}
legend("bottomright", legend = mlabels,
fill   = adjustcolor(.TAB10[seq_along(methods)], 0.78),
bty = "n", cex = 0.85)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot S6: True vs Mean-Aggregated Factors
# -----------------------------------------------------------------------------
plot_s2_true_vs_est <- function(results, first_T = 100, save_path = NULL) {
opened <- .open_device(save_path, width = 800, height = 500)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
cfg    <- results$config
r_true <- cfg$r_true
F_true <- results$data$F
F_est  <- results$stage2$F_mean
TT     <- min(first_T, cfg$T)
t_idx  <- seq_len(TT)
y_rng <- range(c(F_true[t_idx, seq_len(r_true)],
F_est [t_idx, seq_len(r_true)]), na.rm = TRUE)
plot(t_idx, F_true[t_idx, 1], type = "l",
col = "green4", lwd = 2.2, ylim = y_rng,
xlab = "Time", ylab = "Factor Value",
main = sprintf("True vs Mean-Aggregated Factors  (first %d periods)", TT))
lines(t_idx, F_est[t_idx, 1], col = "green4", lwd = 1.6, lty = 2)
if (r_true >= 2) {
lines(t_idx, F_true[t_idx, 2], col = "darkorange", lwd = 2.2)
lines(t_idx, F_est [t_idx, 2], col = "darkorange", lwd = 1.6, lty = 2)
}
leg_labels <- c("True F1 (Strong)", "Est F1",
"True F2 (Weak)",   "Est F2")[seq_len(2 * r_true)]
leg_cols   <- c("green4","green4","darkorange","darkorange")[seq_len(2 * r_true)]
leg_lty    <- c(1, 2, 1, 2)[seq_len(2 * r_true)]
leg_lwd    <- c(2.2, 1.6, 2.2, 1.6)[seq_len(2 * r_true)]
legend("topright", legend = leg_labels,
col = leg_cols, lty = leg_lty, lwd = leg_lwd,
bty = "n", cex = 0.85)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot S7: Full Sample Eigenvalues
# -----------------------------------------------------------------------------
plot_full_eigenvalues <- function(results, save_path = NULL) {
opened <- .open_device(save_path, width = 650, height = 560)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
cfg       <- results$config
r_true    <- cfg$r_true
full_eigs <- results$full_pca$eigenvalues
n_eigs    <- min(8, length(full_eigs))
eigs_plot <- full_eigs[seq_len(n_eigs)]
bp <- barplot(eigs_plot,
names.arg = seq_len(n_eigs),
col    = adjustcolor("steelblue", 0.78),
border = "grey30",
xlab   = "Eigenvalue Index",
ylab   = "Eigenvalue  (X\u2019X / T)",
main   = "Full Sample Eigenvalues")
# vertical line between r_true and r_true+1 bar
abline(v = mean(bp[r_true:(r_true + 1)]),
col = "red", lty = 3, lwd = 2)
if (n_eigs >= 3) {
rat_text <- sprintf("\u03bb2/\u03bb1 = %.3f\n\u03bb3/\u03bb1 = %.3f",
eigs_plot[2] / eigs_plot[1],
eigs_plot[3] / eigs_plot[1])
legend("topright", legend = rat_text,
bty = "o", bg = "wheat", box.col = "grey60", cex = 0.85)
}
legend("right",
legend = sprintf("True r = %d", r_true),
lty = 3, col = "red", lwd = 2, bty = "n", cex = 0.85)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot S8: DGP / Parameter Information Panel
# -----------------------------------------------------------------------------
plot_dgp_info <- function(results, save_path = NULL) {
opened <- .open_device(save_path, width = 600, height = 560)
if (opened) on.exit(dev.off())
op <- par(mar = c(0, 0, 0, 0)); on.exit(par(op), add = TRUE)
cfg <- results$config
snr <- results$snr$snr_primary
plot.new()
plot.window(xlim = c(0, 1), ylim = c(0, 1))
rect(0.03, 0.03, 0.97, 0.97,
col    = adjustcolor("grey85", 0.35),
border = "grey55", lwd = 1.2)
info_lines <- c(
"Data Generating Process: DGP 5",
"(Approximate Factor Model)",
strrep("\u2500", 36),
"",
sprintf("Panel:   N = %d series,  T = %d periods", cfg$N, cfg$T),
"",
sprintf("Factors: R = %d  (true number)", cfg$r_true),
sprintf("  Target SNR  (Strong) = %.1f", cfg$snr_strong),
sprintf("  Target SNR  (Weak)   = %.1f", cfg$snr_weak),
"",
"Signal-to-Noise  (Realized):",
sprintf("  SNR (Strong) = %.3f", snr[1]),
sprintf("  SNR (Weak)   = %.3f", snr[2]),
sprintf("  SNR Ratio    = %.1f\u00d7", snr[1] / snr[2]),
"",
"Error Structure:",
sprintf("  CS correlation  (\u03c1_cs) = %.2f", cfg$rho_cs),
sprintf("  Serial corr.   (\u03c1_ar) = %.2f", cfg$rho_ar),
sprintf("  Heterosk.:  U(%.1f, %.1f)", cfg$sigma_het_low, cfg$sigma_het_high),
"",
sprintf("Subsets used  (Stage 1): %d", results$stage1$n_subsets),
sprintf("Subsets used  (Stage 2): %d  (k \u2265 %d)",
results$stage2$n_subsets, cfg$r_true)
)
text(0.08, 0.95,
paste(info_lines, collapse = "\n"),
adj     = c(0, 1),
cex     = 0.88,
family  = "mono",
xpd     = TRUE)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot S9: Stability Ratio  V(Weak) / V(Strong)
# -----------------------------------------------------------------------------
plot_stability_ratio <- function(results, save_path = NULL) {
opened <- .open_device(save_path, width = 500, height = 560)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
V     <- results$stage2$stability$V
ratio <- if (length(V) >= 2 && is.finite(V[1]) && V[1] > 0)
V[2] / V[1] else NA_real_
bp <- barplot(ratio,
names.arg = "V(Weak) / V(Strong)",
col    = adjustcolor("mediumpurple3", 0.78),
border = "grey30",
ylim   = c(0, max(ratio * 1.3, 1.5, na.rm = TRUE)),
ylab   = "Stability Ratio",
main   = sprintf("Stability Ratio:  %.2f", ratio))
abline(h = 1, col = "grey50", lty = 2, lwd = 1.4)
text(bp, ratio + ratio * 0.05,
labels = sprintf("%.4f", ratio),
cex = 0.95, xpd = TRUE)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot MC1: Survival Rates with Error Bars
# -----------------------------------------------------------------------------
plot_mc_survival_rates <- function(mc, save_path = NULL) {
opened <- .open_device(save_path)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
cfg      <- mc$config
r_max    <- cfg$r_max
r_true   <- cfg$r_true
tau_plot <- cfg$tau_values[seq_len(min(4, length(cfg$tau_values)))]
n_tau    <- length(tau_plot)
x_pos    <- seq_len(r_max) - 1
plot.new()
plot.window(xlim = c(-0.5, r_max - 0.5), ylim = c(0, 1.15))
axis(1, at = x_pos, labels = paste0("PC", seq_len(r_max)))
axis(2); box()
title(xlab = "", ylab = "Survival Rate",
main = "Eigenvalue Survival Rates  (mean \u00b1 std)")
abline(h = 1.0, col = "grey70", lty = 2)
abline(v = r_true - 0.5, col = "red", lty = 3, lwd = 1.8)
for (i in seq_along(tau_plot)) {
tau    <- tau_plot[i]
sr_m   <- mc$SR_mean[[as.character(tau)]][seq_len(r_max)]
sr_s   <- mc$SR_std [[as.character(tau)]][seq_len(r_max)]
offset <- (i - (n_tau + 1) / 2) * 0.15
col_i  <- .TAB10[i]
points(x_pos + offset, sr_m,
pch = 16, col = col_i, cex = 1.0)
arrows(x_pos + offset, pmax(sr_m - sr_s, 0),
x_pos + offset, pmin(sr_m + sr_s, 1.15),
angle = 90, code = 3, length = 0.05,
col = col_i, lwd = 1.3)
}
legend("topright",
legend = paste0("\u03c4 = ", tau_plot),
col    = .TAB10[seq_along(tau_plot)],
pch = 16, bty = "n", cex = 0.85)
legend("topleft",
legend = sprintf("True r = %d", r_true),
lty = 3, col = "red", lwd = 1.8, bty = "n", cex = 0.85)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot MC2: Factor Stability  (log y-axis, with error bars)
# -----------------------------------------------------------------------------
plot_mc_stability <- function(mc, save_path = NULL) {
opened <- .open_device(save_path, width = 600, height = 560)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
cfg    <- mc$config
r_true <- cfg$r_true
V_m    <- mc$V_mean[seq_len(r_true)]
V_s    <- mc$V_std [seq_len(r_true)]
fnames <- c("F1  (Strong)", "F2  (Weak)")[seq_len(r_true)]
fcols  <- c("green3", "orange")[seq_len(r_true)]
log_Vm  <- log10(V_m)
lo      <- log10(pmax(V_m - V_s, 1e-12))
hi      <- log10(V_m + V_s)
y_range <- c(floor(min(lo)) - 0.3, ceiling(max(hi)) + 0.4)
bp <- barplot(log_Vm,
names.arg = fnames,
col    = adjustcolor(fcols, 0.75),
border = "grey30",
ylim   = y_range,
axes   = FALSE,
ylab   = "Stability V",
main   = "Factor Stability  (mean \u00b1 std)")
pow_seq <- seq(floor(y_range[1]), ceiling(y_range[2]))
axis(2, at = pow_seq,
labels = parse(text = paste0("10^", pow_seq)),
las = 1)
box()
arrows(bp, lo, bp, hi,
angle = 90, code = 3, length = 0.07, lwd = 1.6)
text(bp, hi + 0.08,
labels = sprintf("%.3e", V_m),
cex = 0.82, xpd = TRUE)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot MC3: R² vs True Factors  (with error bars)
# -----------------------------------------------------------------------------
plot_mc_r_squared <- function(mc, save_path = NULL) {
opened <- .open_device(save_path)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
cfg     <- mc$config
r_true  <- cfg$r_true
methods <- c("full_sample", "mean_agg", "median_agg", "weighted_agg")
mlabels <- c("Full", "Mean", "Median", "Weighted")
n_m     <- length(methods)
x_pos   <- seq_len(r_true) - 1
w       <- 0.20
plot.new()
plot.window(xlim = c(-0.5, r_true - 0.5), ylim = c(0, 1.15))
axis(1, at = x_pos, labels = paste0("F", seq_len(r_true)))
axis(2); box()
title(xlab = "", ylab = expression(R^2),
main = expression(R^2 ~ "vs True Factors  (mean \u00b1 std)"))
abline(h = 1.0, col = "grey80", lty = 2)
for (i in seq_along(methods)) {
m  <- methods[i]
rm_v <- mc$r_sq_mean[[m]]
rs_v <- mc$r_sq_std [[m]]
if (!is.null(rm_v) && length(rm_v) >= r_true) {
rm_r   <- rm_v[seq_len(r_true)]
rs_r   <- rs_v[seq_len(r_true)]
offset <- (i - (n_m + 1) / 2) * w
rect(x_pos + offset - w / 2, 0,
x_pos + offset + w / 2, rm_r,
col    = adjustcolor(.TAB10[i], 0.78),
border = "white", lwd = 0.5)
arrows(x_pos + offset, pmax(rm_r - rs_r, 0),
x_pos + offset, pmin(rm_r + rs_r, 1.13),
angle = 90, code = 3, length = 0.05, lwd = 1.1)
}
}
legend("bottomright", legend = mlabels,
fill   = adjustcolor(.TAB10[seq_along(methods)], 0.78),
bty = "n", cex = 0.85)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot MC4: Monte Carlo Summary Text Panel
# -----------------------------------------------------------------------------
plot_mc_summary_text <- function(mc, save_path = NULL) {
opened <- .open_device(save_path, width = 600, height = 560)
if (opened) on.exit(dev.off())
op <- par(mar = c(0, 0, 0, 0)); on.exit(par(op), add = TRUE)
cfg <- mc$config
plot.new()
plot.window(xlim = c(0, 1), ylim = c(0, 1))
rect(0.03, 0.03, 0.97, 0.97,
col    = adjustcolor("grey85", 0.35),
border = "grey55", lwd = 1.2)
r_sq_m <- mc$r_sq_mean
fs_r2  <- if (!is.null(r_sq_m$full_sample)) r_sq_m$full_sample else c(NA, NA)
ma_r2  <- if (!is.null(r_sq_m$mean_agg))    r_sq_m$mean_agg    else c(NA, NA)
info <- c(
"MONTE CARLO SUMMARY",
strrep("\u2500", 38),
"",
sprintf("Config:  N = %d,  T = %d,  R = %d", cfg$N, cfg$T, cfg$r_true),
sprintf("Replications: %d", mc$n_replications),
"",
"Signal-to-Noise Ratios:",
sprintf("  SNR (Strong) = %.3f \u00b1 %.3f", mc$snr_mean[1], mc$snr_std[1]),
sprintf("  SNR (Weak)   = %.3f \u00b1 %.3f", mc$snr_mean[2], mc$snr_std[2]),
sprintf("  Ratio        = %.1f\u00d7", mc$snr_mean[1] / mc$snr_mean[2]),
"",
"Stability Variance V:",
sprintf("  V (Strong)   = %.4f \u00b1 %.4f", mc$V_mean[1], mc$V_std[1]),
sprintf("  V (Weak)     = %.4f \u00b1 %.4f", mc$V_mean[2], mc$V_std[2]),
sprintf("  Ratio V2/V1  = %.2f", mc$V_mean[2] / mc$V_mean[1]),
"",
"R\u00b2 vs True Factors:",
sprintf("  Full sample  F1=%.3f  F2=%.3f", fs_r2[1], fs_r2[2]),
sprintf("  Mean agg.    F1=%.3f  F2=%.3f", ma_r2[1], ma_r2[2]),
"",
sprintf("Mean subspace dist: %.4f \u00b1 %.4f",
mc$subspace_dist_mean, mc$subspace_dist_std)
)
text(0.07, 0.95,
paste(info, collapse = "\n"),
adj    = c(0, 1),
cex    = 0.84,
family = "mono",
xpd    = TRUE)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot MC5: Discrimination Gap by Threshold
# -----------------------------------------------------------------------------
plot_mc_discrimination_gap <- function(mc, save_path = NULL) {
opened <- .open_device(save_path, width = 650, height = 520)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
cfg  <- mc$config
gaps <- vapply(cfg$tau_values, function(tau) {
sr <- mc$SR_mean[[as.character(tau)]]
if (length(sr) >= 2) sr[1] - sr[2] else NaN
}, numeric(1))
plot(cfg$tau_values, gaps, type = "o",
pch = 16, cex = 1.1, col = "steelblue", lwd = 2.2,
xlab = "Threshold  \u03c4",
ylab = "SR(Strong) \u2212 SR(Weak)",
main = "Discrimination Gap by Threshold",
ylim = range(c(0, gaps), na.rm = TRUE) + c(-0.05, 0.08))
abline(h = 0, col = "grey55", lty = 2, lwd = 1.2)
points(cfg$tau_values, gaps, pch = 16, col = "steelblue", cex = 1.1)
invisible(NULL)
}
# -----------------------------------------------------------------------------
# Plot MC6: R² Improvement from Mean Aggregation vs Full Sample
# -----------------------------------------------------------------------------
plot_mc_r2_improvement <- function(mc, save_path = NULL) {
opened <- .open_device(save_path, width = 600, height = 520)
if (opened) on.exit(dev.off())
op <- .single_par(); on.exit(par(op), add = TRUE)
cfg   <- mc$config
rm_fs <- mc$r_sq_mean[["full_sample"]]
rm_ma <- mc$r_sq_mean[["mean_agg"]]
if (is.null(rm_fs) || is.null(rm_ma)) {
plot.new()
text(0.5, 0.5, "R\u00b2 data not available", cex = 1.2, col = "grey40")
return(invisible(NULL))
}
r_true      <- cfg$r_true
improvement <- rm_ma[seq_len(r_true)] - rm_fs[seq_len(r_true)]
imp_cols    <- ifelse(improvement > 0, "green3", "firebrick")
y_lim <- range(c(improvement, 0)) + c(-0.02, 0.04)
bp <- barplot(improvement,
names.arg = paste0("F", seq_len(r_true)),
col    = adjustcolor(imp_cols, 0.78),
border = "grey30",
ylim   = y_lim,
ylab   = expression(Delta ~ R^2 ~ "(Mean Agg \u2212 Full Sample)"),
main   = expression(R^2 ~ "Gain: Mean Aggregation vs Full Sample"))
abline(h = 0, col = "grey50", lty = 2, lwd = 1.3)
text(bp, improvement + sign(improvement) * 0.005,
labels = sprintf("%+.4f", improvement),
cex = 0.90, xpd = TRUE,
col = ifelse(improvement > 0, "darkgreen", "firebrick"))
invisible(NULL)
}
plot_all_single <- function(results,
save_dir  = NULL,
prefix    = "sim") {
fns <- list(
plot_s1_survival_rates,
plot_s1_survival_by_size,
plot_s1_eigenvalue_dist,
plot_s2_stability,
plot_s2_r_squared,
plot_s2_true_vs_est,
plot_full_eigenvalues,
plot_dgp_info,
plot_stability_ratio
)
names(fns) <- c(
"01_s1_survival_rates",
"02_s1_survival_by_size",
"03_s1_eigenvalue_dist",
"04_s2_stability",
"05_s2_r_squared",
"06_s2_true_vs_est",
"07_full_eigenvalues",
"08_dgp_info",
"09_stability_ratio"
)
for (nm in names(fns)) {
sp <- if (!is.null(save_dir))
file.path(save_dir, paste0(prefix, "_", nm, ".png"))
else NULL
fns[[nm]](results, save_path = sp)
}
invisible(NULL)
}
plot_all_mc <- function(mc,
save_dir = NULL,
prefix   = "mc") {
fns <- list(
plot_mc_survival_rates,
plot_mc_stability,
plot_mc_r_squared,
plot_mc_summary_text,
plot_mc_discrimination_gap,
plot_mc_r2_improvement
)
names(fns) <- c(
"01_mc_survival_rates",
"02_mc_stability",
"03_mc_r_squared",
"04_mc_summary_text",
"05_mc_discrimination_gap",
"06_mc_r2_improvement"
)
for (nm in names(fns)) {
sp <- if (!is.null(save_dir))
file.path(save_dir, paste0(prefix, "_", nm, ".png"))
else NULL
fns[[nm]](mc, save_path = sp)
}
invisible(NULL)
}
plot_s1_survival_rates(results$single)
plot_s2_stability(results$single)
# All at once, optionally saving to PNGs:
plot_all_single(results$single, save_dir = "/Users/boris/Desktop/RSShapley/Marco")
plot_all_mc(results$mc, save_dir = "/Users/boris/Desktop/RSShapley/Marco")
